# --- Portail partenaires (/portail) ---

# Base Turso : turso db create apolo-portail && turso db show apolo-portail --url
# puis turso db tokens create apolo-portail
# Sans ces variables, le développement utilise un fichier local (data/portal.db).
TURSO_DATABASE_URL=libsql://apolo-portail-<compte>.turso.io
TURSO_AUTH_TOKEN=

# Secret de signature des cookies de session : 32 caractères minimum (openssl rand -base64 48)
PORTAL_SESSION_SECRET=

# Administrateur : adresse(s) Google autorisée(s), séparées par des virgules.
# L'administrateur se connecte uniquement via « Se connecter avec Google » (pas de mot de passe).
PORTAL_ADMIN_EMAIL=

# Connexion Google : console.cloud.google.com → API et services → Identifiants → ID client OAuth (application Web).
# URI de redirection autorisée : https://<votre-domaine>/api/portal/google/callback
# (et http://localhost:3000/api/portal/google/callback en local)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Anti-robot de la page d'inscription client : Cloudflare Turnstile (gratuit),
# dash.cloudflare.com → Turnstile → Add widget. Sans ces clés, l'inscription est fermée en production.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Optionnel : 1 pour insérer les données de démonstration dans une base vide, même en production
# PORTAL_SEED_DEMO=1
