# Formulaire de contact (app/api/contact/route.ts) — envoi par un script Google
# Apps Script gratuit qui poste le mail depuis le compte Gmail.
# Mise en place pas à pas : google-apps-script/contact-mailer.gs
# Sans ces deux variables, le formulaire s'affiche mais l'envoi échoue proprement
# (message d'erreur avec téléphone et email en repli).

# URL de l'application web Apps Script (se termine par /exec)
CONTACT_WEBHOOK_URL=
# Même phrase secrète que la constante SECRET du script (30 caractères ou plus)
CONTACT_WEBHOOK_SECRET=

# Avis Google (lib/reviews.ts)
GOOGLE_MAPS_API_KEY=
GOOGLE_PLACE_ID=
