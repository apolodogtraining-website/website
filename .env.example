# Formulaire de contact (app/api/contact/route.ts) — envoi par Resend (resend.com).
# Sans RESEND_API_KEY, le formulaire s'affiche mais l'envoi échoue proprement
# (message d'erreur avec téléphone et email en repli).
RESEND_API_KEY=

# Boîte qui reçoit les demandes (défaut : l'email de lib/site.ts).
CONTACT_TO_EMAIL=

# Expéditeur. Le défaut « onboarding@resend.dev » ne livre qu'à l'adresse du
# compte Resend : suffisant pour tester. En production, vérifier le domaine
# apolodogtraining.com dans Resend puis renseigner par exemple :
# CONTACT_FROM_EMAIL="Apolo Dog Training <contact@apolodogtraining.com>"
CONTACT_FROM_EMAIL=

# Avis Google (lib/reviews.ts)
GOOGLE_MAPS_API_KEY=
GOOGLE_PLACE_ID=
